generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooler (runtime)
  directUrl = env("DIRECT_URL")     // koneksi langsung (untuk migrasi)
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  password           String
  role               String    // ADMIN_UTAMA | ADMIN_PEMBANTU | PEGAWAI
  nama               String
  pegawaiId          Int?      @unique
  pegawai            Pegawai?  @relation(fields: [pegawaiId], references: [id], onDelete: SetNull)
  mustChangePassword Boolean   @default(false) // wajib ganti password (mis. masih password default NIP)
  gagalLogin         Int       @default(0)     // percobaan login gagal beruntun
  terkunciSampai     DateTime?                 // akun terkunci sementara sampai waktu ini
  loginTerakhir      DateTime?
  createdAt          DateTime  @default(now())
}

model Pegawai {
  id                 Int     @id @default(autoincrement())
  nip                String  @unique // NIP BARU
  nik                String?
  nama               String
  tempatLahir        String? // TEMPAT LAHIR NAMA
  tanggalLahir       String?
  jenisKelamin       String?
  statusCpnsPns      String? // STATUS CPNS PNS
  tanggalSkCpns      String?
  tmtCpns            String?
  tanggalSkPns       String?
  tmtPns             String?
  golAwal            String? // GOL AWAL NAMA
  golAkhir           String? // GOL AKHIR NAMA
  tmtGolongan        String?
  jenisJabatan       String? // JENIS JABATAN NAMA
  jabatan            String? // JABATAN NAMA
  tmtJabatan         String?
  tingkatPendidikan  String? // TINGKAT PENDIDIKAN NAMA
  pendidikan         String? // PENDIDIKAN NAMA
  kecamatan          String?
  unor               String? // UNOR NAMA
  tempatTugas        String?
  status             String? // STATUS
  tanggalKgbTerakhir String? // TANGGAL KENAIKAN GAJI BERKALA TERAKHIR
  tanggalKpTerakhir  String? // TANGGAL KENAIKAN PANGKAT TERAKHIR
  tanggalPensiun     String?
  tanggalKgb         String? // TANGGAL KENAIKAN GAJI BERKALA (berikutnya)
  tanggalKp          String? // TANGGAL KENAIKAN PANGKAT (berikutnya)
  tahunPengangkatan  String?
  aktif              Boolean @default(true)

  user      User?
  cuti      PengajuanCuti[]
  perubahan PerubahanData[]
  dokumen   DokumenPegawai[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PengajuanCuti {
  id              Int      @id @default(autoincrement())
  pegawaiId       Int
  pegawai         Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)
  jenisCuti       String   // TAHUNAN | MELAHIRKAN | TAHUNAN_UMROH | SAKIT | ALASAN_PENTING
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  lamaCuti        Int
  alasan          String
  alamatSelamaCuti String?
  noHp            String?
  polaKerja       String   @default("5_HARI") // 5_HARI | 6_HARI | KALENDER
  status          String   @default("DIAJUKAN") // DIAJUKAN | DISETUJUI | DIKEMBALIKAN | DITOLAK
  catatan         String?  // catatan admin saat aksi
  diajukanOlehId  Int?     // user id pembuat pengajuan
  diprosesOleh    String?  // nama admin pemroses
  berkas          BerkasCuti[]
  riwayat         RiwayatCuti[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BerkasCuti {
  id          Int           @id @default(autoincrement())
  cutiId      Int
  cuti        PengajuanCuti @relation(fields: [cutiId], references: [id], onDelete: Cascade)
  jenisBerkas String        // kode kebutuhan berkas, mis. REKOMENDASI_KEPSEK
  namaBerkas  String        // label kebutuhan
  namaFile    String        // nama file asli
  path        String        // path tersimpan
  mimeType    String?
  ukuran      Int?
  createdAt   DateTime      @default(now())
}

model RiwayatCuti {
  id        Int           @id @default(autoincrement())
  cutiId    Int
  cuti      PengajuanCuti @relation(fields: [cutiId], references: [id], onDelete: Cascade)
  aksi      String        // DIAJUKAN | DISETUJUI | DIKEMBALIKAN | DITOLAK | DIPERBAIKI
  oleh      String
  catatan   String?
  createdAt DateTime      @default(now())
}

model PerubahanData {
  id           Int      @id @default(autoincrement())
  pegawaiId    Int
  pegawai      Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)
  dataBaru     String   // JSON field->nilai baru yang diusulkan
  alasan       String?
  status       String   @default("DIAJUKAN") // DIAJUKAN | DISETUJUI | DITOLAK
  catatan      String?
  diprosesOleh String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DokumenPegawai {
  id        Int      @id @default(autoincrement())
  pegawaiId Int
  pegawai   Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)
  jenis     String   // SK_CPNS | SK_PNS | SK_PANGKAT_TERAKHIR | KGB_TERAKHIR | SK_TERAKHIR
  namaFile  String
  path      String
  mimeType  String?
  ukuran    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pegawaiId, jenis])
}

model HariLibur {
  id         Int    @id @default(autoincrement())
  tanggal    String @unique // YYYY-MM-DD
  keterangan String
  createdAt  DateTime @default(now())
}
