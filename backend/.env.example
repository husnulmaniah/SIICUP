# --- Untuk development lokal (isi salah satu cara di bawah) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cuti_app
DB_SSLMODE=disable

# --- Untuk deploy ke Railway/Render/Neon dsb: cukup isi DATABASE_URL saja, ---
# --- ini akan menggantikan semua DB_* di atas jika diisi.                  ---
# DATABASE_URL=postgresql://user:password@host:5432/namadb?sslmode=require

JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
APP_PORT=8080

# Daftar origin frontend yang diizinkan (production), pisahkan dengan koma.
# Kosongkan untuk mengizinkan semua origin (cukup untuk development lokal).
# FRONTEND_ORIGINS=https://siicup.vercel.app
