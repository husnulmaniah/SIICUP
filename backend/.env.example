# === WAJIB DIISI ===
# PostgreSQL (Neon / Vercel Postgres / Supabase). Contoh:
# DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/sicuti?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sicuti"

# Rahasia JWT — ganti dengan string acak panjang
JWT_SECRET="sicuti-rahasia-ganti-di-produksi"

# === OPSIONAL ===
# Jika diisi, berkas disimpan di Vercel Blob; jika kosong, disimpan di folder ./uploads (mode lokal/VPS)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
