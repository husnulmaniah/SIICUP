    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "@vercel/blob": "^0.27.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}